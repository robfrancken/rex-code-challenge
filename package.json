{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.1.2",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js vite.config.ts --max-warnings 0",
        "format": "prettier --write resources/js",
        "test": "vitest run",
        "api:types": "openapi-typescript app/Modules/Contacts/Presentation/Http/openapi.json -o resources/js/lib/api/schema.d.ts"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "3.1.3",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.5"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.104.5",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.61.0",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-router": "^8.5.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0"
    }
}
